# VCB Bot Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# VCB Credentials
VCB_USER=09xxxxxxxxx
VCB_PASS=your_password_here
VCB_ACC=your_account_number
VCB_BROWSER_ID=your_fingerprint_from_vcb_browserid_tool

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token
MY_CHAT_ID=your_admin_chat_id

# Google Sheet
SHEET_ID=your_google_sheet_id
BOT_EMAIL=your_bot_notification_email

# HuggingFace Space (optional - default is your space)
HF_API=https://thangnd163063-captcha.hf.space/predict
